{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Persona Quiz Version Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "default_version", "versions"],
  "properties": {
    "$schema": { "const": "../schemas/quiz-version-registry.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "default_version": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent", "accent_light", "card"],
      "properties": {
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent_light": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "card": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "order", "bank_version", "tag_prefix", "title", "identity_name", "identity_desc", "icon", "quiz_label", "welcome_label", "welcome_copy", "cache_namespace", "public_bank_file", "theme"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        "enabled": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 1 },
        "bank_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "tag_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,7}$" },
        "title": { "type": "string", "minLength": 1 },
        "identity_name": { "type": "string", "minLength": 1 },
        "identity_desc": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 },
        "quiz_label": { "type": "string", "minLength": 1 },
        "welcome_label": { "type": "string", "minLength": 1 },
        "welcome_copy": { "type": "string", "minLength": 1 },
        "cache_namespace": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "public_bank_file": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\.v[0-9]+\\.[0-9]+\\.[0-9]+\\.public\\.json$" },
        "theme": { "$ref": "#/$defs/theme" }
      }
    }
  }
}
